{
  "name": "faceflow-desktop",
  "productName": "FaceFlow",
  "version": "1.0.0",
  "private": true,
  "description": "Private photo organization, powered locally. Groups photos by whose face is in them, entirely on-device.",
  "author": "FaceSort contributors",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "electron:start": "electron .",
    "electron:build": "electron-builder",
    "build": "electron-builder",
    "dist": "electron-builder --win nsis --x64",
    "dist:dir": "electron-builder --dir --win --x64",
    "dist:portable": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "org.faceflow.app",
    "productName": "FaceFlow",
    "copyright": "Copyright \u00a9 2026",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../python_build/dist/backend",
        "to": ".",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "FaceFlow-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FaceFlow"
    },
    "portable": {
      "artifactName": "FaceFlow-Portable-${version}.${ext}"
    }
  }
}
